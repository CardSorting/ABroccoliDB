{
	"name": "@noorm/broccolidb",
	"version": "3.0.0",
	"description": "Dependency-free embedded JSON database with typed tables, SQLite-inspired JSONSQL, WAL recovery, checkpoints, and content-addressed blob storage.",
	"type": "module",
	"author": {
		"name": "William Andrew Cruz",
		"url": "https://github.com/CardSorting"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/CardSorting/ABroccoliDB.git"
	},
	"bugs": {
		"url": "https://github.com/CardSorting/ABroccoliDB/issues"
	},
	"homepage": "https://github.com/CardSorting/ABroccoliDB#readme",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE",
		"NOTICE",
		"PATENT-NON-AGGRESSION-PLEDGE.md",
		"TRADEMARKS.md",
		"AGENTS.md",
		"SECURITY.md",
		"CONTRIBUTING.md",
		"DCO"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/add-spdx-to-dist.mjs",
		"test": "npm run build && node --test --import tsx/esm test/*.test.ts",
		"docs:check": "node scripts/check-docs.mjs",
		"license:check": "node scripts/check-licensing.mjs",
		"ip:check": "node scripts/check-ip-claims.mjs",
		"package:check": "node scripts/check-package-boundary.mjs",
		"check": "npm run docs:check && npm run ip:check && npm test && npm run license:check && npm run package:check"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"broccolidb",
		"database",
		"json-database",
		"embedded-database",
		"jsonsql",
		"in-memory",
		"wal",
		"cas",
		"portable"
	],
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/node": "^20.19.43",
		"tsx": "^4.21.1",
		"typescript": "^5.4.5"
	}
}
